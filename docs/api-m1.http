GET {{base}}/practitioners/me/replacements
Authorization: Bearer {{accessToken}}

### 22. Secretaire medicale : profil, droits granulaires, multi-cabinets et audit trail
GET {{base}}/secretaries/me
Authorization: Bearer {{accessToken}}

###
PUT {{base}}/secretaries/5/permissions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "permissionCodes": ["agenda.read", "agenda.write", "appointment.read", "appointment.write", "appointment.cancel"]
}

###
PUT {{base}}/secretaries/5/assignments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "supervisedPractitionerIds": [2],
  "accessibleEstablishmentIds": [3]
}

###
GET {{base}}/secretaries/5/audit
Authorization: Bearer {{accessToken}}

### 23. Etablissement : services/departements, facturation groupee et tableau de bord consolide
PUT {{base}}/establishments/me/departments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "departments": ["Cardiologie", "Imagerie", "Pediatrie", "Urgences"]
}

###
POST {{base}}/establishments/me/billing/invoices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{

<?xml version="1.0" encoding="UTF-8"?>
<!--
  PRDV - Plateforme de prise de rendez-vous medicaux
  Build multi-modules qui ENFORCE l'architecture hexagonale :
    prdv-core         -> domaine + cas d'utilisation + ports (AUCUNE dependance Spring/JPA)
    prdv-adapters-in  -> adaptateurs primaires (REST, securite JWT)
    prdv-adapters-out -> adaptateurs secondaires (MySQL/JPA, email/SMS, JWT, IA stubs)
    prdv-app          -> bootstrap Spring Boot + câblage (composition root) + Flyway + Docker
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.prdv</groupId>
  <artifactId>prdv-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>PRDV Backend (Hexagonal)</name>

  <modules>
    <module>prdv-core</module>
    <module>prdv-adapters-in</module>
    <module>prdv-adapters-out</module>
    <module>prdv-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.6</jjwt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.prdv</groupId><artifactId>prdv-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.prdv</groupId><artifactId>prdv-adapters-in</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.prdv</groupId><artifactId>prdv-adapters-out</artifactId><version>${project.version}</version></dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>${jjwt.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  COEUR HEXAGONAL : domaine metier + cas d'utilisation + ports (interfaces).
  Regle d'or (Dependency Inversion) : ce module ne depend d'AUCUN framework.
  Only pure Java + JUnit for tests. C'est ce module qui definit les contrats
  (ports) que les adaptateurs viennent implementer.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.prdv</groupId><artifactId>prdv-backend</artifactId><version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>prdv-core</artifactId>
  <name>PRDV :: Core (domain + use cases + ports)</name>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope>
    </dependency>
  </dependencies>
</project>
